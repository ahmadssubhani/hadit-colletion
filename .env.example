# Browser-safe Supabase project URL (no /rest/v1/ suffix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe anonymous key. Pair with read-only RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for local ingestion scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Direct or pooled Postgres connection string for tooling.
DATABASE_URL=
